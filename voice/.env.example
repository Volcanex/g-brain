# Voice service env. The real file (voice/.env) is written by push-secrets from
# the instance passport. Never commit voice/.env. These are the keys it expects:

OPENROUTER_API_KEY=
VOICE_MODEL=anthropic/claude-haiku-4.5

# WhatsApp via Telnyx (Telnyx is the BSP)
TELNYX_API_KEY=
TELNYX_WHATSAPP_NUMBER=        # bot sender number, +E.164 (e.g. +447...)
TELNYX_PUBLIC_KEY=             # base64 Ed25519 public key (Mission Control → Keys & Credentials)

# Comma-separated E.164 numbers (with or without '+') allowed to talk to the brain.
VOICE_ALLOWED_NUMBERS=
